# =====================================================================
# Боевое окружение (Production) для сайта штабсо-двфу.рф
# Скопируйте в .env на сервере: cp .env.prod.example .env
# =====================================================================

DJANGO_SETTINGS_MODULE=config.settings.prod

# Сгенерируйте надежный ключ: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-very-long-random-secret-key-at-least-50-chars

DJANGO_DEBUG=false

# Домены сайта (Punycode и кириллица)
DJANGO_ALLOWED_HOSTS=xn----7sbdfj2duafqj9a.xn--p1ai,штабсо-двфу.рф,localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=https://xn----7sbdfj2duafqj9a.xn--p1ai,https://штабсо-двфу.рф

# База данных PostgreSQL (надежный пароль)
POSTGRES_DB=shso
POSTGRES_USER=shso
POSTGRES_PASSWORD=generate_strong_db_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Путь к медиа-файлам в контейнере
MEDIA_ROOT=/app/media

# Настройки безопасности SSL (включены в prod.py по умолчанию)
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000

# Почта (SMTP провайдера, например Yandex 360 / Mail.ru / VK WorkMail)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_HOST_USER=noreply@штабсо-двфу.рф
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=ШСО ДВФУ <noreply@штабсо-двфу.рф>

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_production_bot_token
TELEGRAM_BOT_USERNAME=shso_fefu_bot
TELEGRAM_HQ_CHAT_ID=your_headquarters_chat_id
TELEGRAM_API_URL=https://api.telegram.org
