# Скопируйте в .env:  copy .env.example .env   (Windows)  /  cp .env.example .env
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-change-me-please-0123456789abcdef0123456789
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_DB=shso
POSTGRES_USER=shso
POSTGRES_PASSWORD=shso_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Почта: в разработке письма печатаются в консоль
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=shso_fefu_bot
TELEGRAM_HQ_CHAT_ID=
TELEGRAM_API_PROXY=
TELEGRAM_API_URL=https://api.telegram.org

# Только для боевого окружения:
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=0
